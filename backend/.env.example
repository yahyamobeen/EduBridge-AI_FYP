# EduBridge AI — backend environment template  (TDD §8.2)
#
# USAGE:  cp .env.example .env   then fill in real values.
# NEVER commit the resulting .env — it is gitignored on purpose (SEC-10).
# In CI/CD these are supplied as encrypted GitHub Actions secrets (TDD §8.4).

# ─────────────── Application ───────────────
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_PATH=/api

# ─────────────── Database — Supabase PostgreSQL (source of truth) ───────────────
#
# DATABASE_URL MUST CONNECT AS app_backend, NEVER AS postgres.
#   postgres bypasses Row Level Security, which would leave all 60+ policies
#   inert while everything appears to work perfectly. The app refuses to start
#   if the role reports rolsuper or rolbypassrls (app/core/db.py).
#
# Format (Supabase pooler):
#   postgresql+psycopg://app_backend.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=postgresql+psycopg://app_backend.CHANGE_ME:CHANGE_ME@CHANGE_ME.pooler.supabase.com:5432/postgres

# Bypasses RLS on purpose. BACKGROUND JOBS ONLY — the ETL, the trial sweeper,
# reconciliation. No request path may use it; pre-authentication lookups go
# through the SECURITY DEFINER functions in migration 20260802140000 instead.
SERVICE_ROLE_DATABASE_URL=postgresql+psycopg://postgres.CHANGE_ME:CHANGE_ME@CHANGE_ME.pooler.supabase.com:5432/postgres

ANALYTICS_SCHEMA=analytics

# Origins allowed to make CREDENTIALED cross-origin requests. Comma-separated.
# NEVER "*": with credentials enabled, a wildcard makes Starlette echo the
# caller's origin, so any site could use a user's refresh cookie. Rejected
# outright when APP_ENV=production.
CORS_ORIGINS=["http://localhost:3000"]

# ─────────────── Vector store (embeddings, BGE-M3 1024-dim) ───────────────
VECTOR_DB_URL=http://localhost:8000
VECTOR_COLLECTION_PREFIX=edubridge

# ─────────────── Redis — cache, rate-limit buckets, Celery broker ───────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─────────────── Auth / JWT ───────────────
# Generate strong values:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ─────────────── 2FA / TOTP ───────────────
# Encryption key for TOTP secrets at rest (AES via Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=CHANGE_ME_generate_with_fernet

# ─────────────── Cloudflare Turnstile (CAPTCHA) ───────────────
# Secret key for the SERVER-SIDE siteverify call on /auth/register and
# /auth/login. NEVER expose this to the browser — it has no NEXT_PUBLIC_ twin.
# Create the widget in the Cloudflare dashboard and paste its SECRET key here
# (the site key goes in frontend/.env.local as NEXT_PUBLIC_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=CHANGE_ME_create_in_cloudflare_dashboard

# ─────────────── Email delivery ───────────────
# NO PROVIDER IS SETTLED. The seam is (app/auth/email.py); the choice is not.
# "logging" records metadata only and sends nothing — correct for development
# and CI, and REFUSED in production, because verification links that go to a log
# file mean nobody can finish signing up.
# "resend" needs the optional SDK: uv sync --extra email
EMAIL_PROVIDER=logging
# Only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Only when EMAIL_PROVIDER=resend. No default: a sender address is a decision
# about a verified domain, not something to inherit from a template.
EMAIL_FROM=
# Base URL for the frontend — used to build verification/reset links in emails.
APP_BASE_URL=http://localhost:3000

# ─────────────── Models (self-hosted primary + hosted fallback) ───────────────
LLM_ENDPOINT=http://localhost:8001/v1
LLM_FALLBACK_API=
LLM_FALLBACK_API_KEY=
EMBEDDING_ENDPOINT=http://localhost:8002
RERANK_ENDPOINT=http://localhost:8003
GUARDRAIL_ENDPOINT=http://localhost:8004

# ─────────────── MCP servers (audited, separate processes) ───────────────
TTS_MCP=http://localhost:9001
STT_MCP=http://localhost:9002
OCR_MCP=http://localhost:9003

# ─────────────── Platform / safety ───────────────
RATE_LIMIT_DEFAULT=60/min           # per user & per IP (SEC-3 / OWASP LLM10)
RATE_LIMIT_INSTITUTION=600/min      # higher ceiling for known institution egress IPs
SIM_THRESHOLD=0.55                  # grounding gate [PROPOSED — tune during eval]
REQUEST_LOG_RETENTION_DAYS=30       # api_request_log daily partitions (TEL-5)
