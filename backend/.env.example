# EduBridge AI — backend environment template  (TDD §8.2)
#
# USAGE:  cp .env.example .env   then fill in real values.
# NEVER commit the resulting .env — it is gitignored on purpose (SEC-10).
# In CI/CD these are supplied as encrypted GitHub Actions secrets (TDD §8.4).

# ─────────────── Application ───────────────
APP_ENV=development
LOG_LEVEL=INFO
API_BASE_PATH=/api

# ─────────────── Database — PostgreSQL OLTP (source of truth) ───────────────
DATABASE_URL=postgresql+psycopg://edubridge:CHANGE_ME@localhost:5432/edubridge
ANALYTICS_SCHEMA=analytics

# ─────────────── Vector store (embeddings, BGE-M3 1024-dim) ───────────────
VECTOR_DB_URL=http://localhost:8000
VECTOR_COLLECTION_PREFIX=edubridge

# ─────────────── Redis — cache, rate-limit buckets, Celery broker ───────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─────────────── Auth / JWT ───────────────
# Generate strong values:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ─────────────── Models (self-hosted primary + hosted fallback) ───────────────
LLM_ENDPOINT=http://localhost:8001/v1
LLM_FALLBACK_API=
LLM_FALLBACK_API_KEY=
EMBEDDING_ENDPOINT=http://localhost:8002
RERANK_ENDPOINT=http://localhost:8003
GUARDRAIL_ENDPOINT=http://localhost:8004

# ─────────────── MCP servers (audited, separate processes) ───────────────
TTS_MCP=http://localhost:9001
STT_MCP=http://localhost:9002
OCR_MCP=http://localhost:9003

# ─────────────── Platform / safety ───────────────
RATE_LIMIT_DEFAULT=60/min           # per user & per IP (SEC-3 / OWASP LLM10)
RATE_LIMIT_INSTITUTION=600/min      # higher ceiling for known institution egress IPs
SIM_THRESHOLD=0.55                  # grounding gate [PROPOSED — tune during eval]
REQUEST_LOG_RETENTION_DAYS=30       # api_request_log daily partitions (TEL-5)
