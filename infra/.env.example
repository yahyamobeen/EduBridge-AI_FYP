# EduBridge AI — infrastructure / docker-compose environment template
#
# USAGE:  cp .env.example .env   then fill in real values.
# Consumed by docker-compose to provision Postgres, Redis and the vector DB.

# ─────────────── PostgreSQL ───────────────
POSTGRES_USER=edubridge
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=edubridge
POSTGRES_PORT=5432

# ─────────────── Redis ───────────────
REDIS_PORT=6379

# ─────────────── Vector DB ───────────────
VECTOR_DB_PORT=8000

# ─────────────── Service ports ───────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ─────────────── GPU / model serving (mostly cloud-hosted) ───────────────
GPU_HOST=
GPU_SSH_USER=
