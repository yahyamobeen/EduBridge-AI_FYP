# EduBridge AI — frontend environment template (Next.js)
#
# USAGE:  cp .env.example .env.local   then fill in real values.
# .env.local is gitignored. NEXT_PUBLIC_* values are exposed to the browser —
# never put secrets behind that prefix.

# REQUIRED. There is no mock layer and no offline mode: the backend must be
# running, locally or deployed. `NEXT_PUBLIC_API_MODE` no longer exists.
#
# Server components fetch through this directly, so leaving it unset makes them
# fail with a named error rather than a URL parse error. In the browser the
# requests go out relative and are rewritten by next.config.mjs, which is what
# keeps the refresh cookie same-site — do not point this at the backend's public
# address in production (frontend/CLAUDE.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_DEFAULT_LOCALE=en          # en | ur | ur-Latn  (API sends roman_ur for ur-Latn)
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ur,ur-Latn

# Server-side only (NOT exposed to the browser)
BACKEND_INTERNAL_URL=http://localhost:8000

# The unlisted path the administrator login is served at, WITHOUT a leading
# slash. `proxy.ts` rewrites it to the login page; every other path that would
# reach that page is answered with a 404.
#
# ⚠️ NEVER GIVE THIS THE `NEXT_PUBLIC_` PREFIX. That prefix inlines a value into
#    the browser bundle at build time, which would publish the path to every
#    visitor.
# ⚠️ THE VALUE BELOW IS A PLACEHOLDER, not the real path. Put the real one in
#    .env.local (gitignored) and in the Render dashboard.
#
# UNLIKE the NEXT_PUBLIC_* values above, this is read at RUNTIME, so changing it
# needs a restart rather than a rebuild. Measured on a production build: the
# server chunk keeps the literal `process.env.ADMIN_LOGIN_PATH` read, and
# `grep -rl <the value> .next/` finds nothing anywhere — not in .next/static,
# and not in the middleware bundle either.
#
# Unset is safe and fails closed — no rewrite, so the administrator login is
# simply unreachable. It is not a security control either way: the control is
# POST /api/auth/admin/login, which refuses non-administrators with a 401
# identical to a wrong password.
ADMIN_LOGIN_PATH=replace-me-with-an-unlisted-path

# Cloudflare Turnstile — PUBLIC site key (safe to expose in the browser; the
# SECRET key lives only in backend/.env as TURNSTILE_SECRET_KEY).
# Put the real site key in .env.local (gitignored). The widget renders only
# when a value is present.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEKhg-Qtr2h7j9ek
