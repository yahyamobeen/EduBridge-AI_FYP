# EduBridge AI — frontend environment template (Next.js)
#
# USAGE:  cp .env.example .env.local   then fill in real values.
# .env.local is gitignored. NEXT_PUBLIC_* values are exposed to the browser —
# never put secrets behind that prefix.

# mock  = in-memory handlers matching the contracts in tdd.md §3.1 / §7
# live  = the real FastAPI backend
# This is the single switch: nothing else changes when the backend lands.
NEXT_PUBLIC_API_MODE=mock

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_DEFAULT_LOCALE=en          # en | ur | ur-Latn  (API sends roman_ur for ur-Latn)
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ur,ur-Latn

# Server-side only (NOT exposed to the browser)
BACKEND_INTERNAL_URL=http://localhost:8000

# Cloudflare Turnstile — PUBLIC site key (safe to expose in the browser; the
# SECRET key lives only in backend/.env as TURNSTILE_SECRET_KEY).
# Put the real site key in .env.local (gitignored). The widget renders only
# when a value is present.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
