# EduBridge AI — MCP servers environment template
#
# USAGE:  cp .env.example .env   then fill in real values.
# Each MCP server runs as a separate, sandboxed process with least-privilege
# permissions from its manifest (TDD §6.2). Grant only what the manifest declares.

# ─────────────── tts_avatar (Fish Audio S2 Pro + MuseTalk) ───────────────
FISH_S2_MODEL_PATH=
FISH_S2_API_KEY=
MUSETALK_MODEL_PATH=
TTS_DEFAULT_VOICE=
TTS_URDU_FALLBACK_VOICE=ur-PK          # fallback when Urdu quality is poor (PRD §20)

# ─────────────── stt (Whisper) ───────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda

# ─────────────── ocr ───────────────
OCR_LANGUAGES=eng+urd

# ─────────────── translation ───────────────
TRANSLATION_ENDPOINT=

# ─────────────── web_search (P2 — highest injection risk, tightest allowlist) ───────────────
WEB_SEARCH_API_KEY=
WEB_SEARCH_ALLOWLIST=                  # comma-separated hosts; empty = deny all
